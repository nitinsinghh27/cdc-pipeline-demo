# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Local Docker services (defaults match docker-compose.yml) ─────────────────

# PostgreSQL (destination)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=staging_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_pass

# MySQL (source — read-only queries for lag comparison)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=demo_db
MYSQL_USER=app_user
MYSQL_PASSWORD=app_pass

# Grafana (dashboards, alerts, Loki, Prometheus queries)
GRAFANA_BASE_URL=http://localhost:3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
# OR use a service account token (preferred):
# GRAFANA_API_KEY=glsa_...

# MinIO (S3-compatible object storage — staging layer)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cdc-events
# MinIO Console (web UI): http://localhost:9001

# Kafka Connect (Debezium) — no auth in local demo
KAFKA_CONNECT_URL=http://localhost:8083

# Redpanda Admin API
REDPANDA_ADMIN_URL=http://localhost:9644
